# gamma-omm email configuration
# Copy to .env and fill in values. .env is gitignored — never commit real addresses.

# ── GEX Daily Report (Index: SPY / QQQ / IWM) ─────────────────────────────────
# Comma-separated list of recipient addresses.
# Example: GEX_EMAIL_TO=you@example.com,colleague@example.com
GEX_EMAIL_TO=

# ── Purpose Yield ETF Report (16 underlyings) ─────────────────────────────────
# Falls back to GEX_EMAIL_TO if left blank.
YIELD_EMAIL_TO=

# ── Optional: S3 hosting for the interactive yield HTML report ─────────────────
# When YIELD_S3_BUCKET is set, run_daily_yield --send uploads the report and
# emails recipients a presigned link instead of attaching the HTML directly.
# If unset, the HTML file is attached to the email.
YIELD_S3_BUCKET=
YIELD_S3_PREFIX=yield/
YIELD_S3_EXPIRY=604800

# ── Automation (Task Scheduler) ────────────────────────────────────────────────
# Register or check scheduled tasks:
#   .\runners\gex_daily.ps1   activate | deactivate | status   (4:30 PM ET)
#   .\runners\yield_daily.ps1 activate | deactivate | status   (4:35 PM ET)
# Set GEX_SEND=1 here to authorize sends when running the scripts manually.
# GEX_SEND=1
