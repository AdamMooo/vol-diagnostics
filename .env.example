# Vol Diagnostics — Environment Variables (TEMPLATE)
# Copy to .env and fill in values. .env is gitignored — it never enters git.
# On a new machine, copy the real .env over out-of-band (it is not cloned).

# ── Email (daily report) ──────────────────────────────────────────────────────
# Comma-separated recipient list.
GEX_EMAIL_TO=

# SMTP — used on Linux/Docker/GitHub Actions (Outlook COM is used on local Windows).
# Gmail: smtp.gmail.com / 587, and SMTP_PASS must be a 16-char App Password
# (Google Account -> Security -> 2-Step Verification -> App Passwords), NOT your login.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Dashboard auth ────────────────────────────────────────────────────────────
# Streamlit password gate. Leave empty — the public app has no gate today.
PASSWORD=

# ── OCI Object Storage backup/restore (Customer Secret Key — S3-compatible API) ──
# OCI_NAMESPACE        : Console -> Object Storage -> Buckets, "Namespace" at top.
# OCI_ACCESS_KEY_ID    : Console -> My Profile -> Customer Secret Keys -> Generate.
# OCI_CUSTOMER_SECRET_KEY: shown ONCE at generation — copy immediately.
OCI_NAMESPACE=
OCI_ACCESS_KEY_ID=
OCI_CUSTOMER_SECRET_KEY=

# ── OCI Compute API (permanent API signing key — provisioning, e.g. A1.Flex retry) ──
# DIFFERENT credential from the Customer Secret Key above (native API, not S3).
# Console -> My Profile -> API Keys -> Add API Key -> Generate Key Pair -> Download.
# The console then shows a config block with the fingerprint / tenancy / user OCIDs.
OCI_CLI_USER=
OCI_CLI_FINGERPRINT=
OCI_CLI_TENANCY=
# Full contents of the downloaded private-key .pem, including BEGIN/END lines
# (quoted, multi-line).
OCI_CLI_KEY_CONTENT=

# ── OCI instance-provisioning identifiers (not secret, needed alongside the above) ──
OCI_COMPARTMENT_ID=
# Contents of your SSH public key (vol-diagnostics.pub) — the new instance's login key.
VOL_DIAGNOSTICS_SSH_PUBLIC_KEY=
# One line per region/AD to try, pipe-separated: region|AD|subnet_id|image_id
OCI_A1_TARGETS=

# ── Optional ───────────────────────────────────────────────────────────────────
# Domain for Caddy HTTPS (leave empty for IP/nip.io-only access).
DOMAIN=
