# Vol Diagnostics — Environment Variables
# Copy to .env and fill in values.

# Email recipients (comma-separated) for daily report
GEX_EMAIL_TO=you@example.com

# SMTP settings (for Docker/Linux — Outlook COM not available)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com

# Streamlit password (leave empty for no auth)
PASSWORD=

# Optional: domain for Caddy HTTPS (leave empty for IP-only)
DOMAIN=
